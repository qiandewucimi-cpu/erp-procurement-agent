# 复制为 .env 并按需填写（.env 已被 .gitignore 排除，不会提交）。

# ---- 推荐：云端模型（支持工具调用，实现真正的 Agent 工具循环）----
# 智谱（OpenAI 兼容，glm-4-flash 支持 function calling）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_API_KEY=替换成你的key

# 备选：千问 DashScope（OpenAI 兼容）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-替换成你的key

# ---- 备选：本地 Ollama（离线可用；小模型工具调用不稳，建议 ≥ qwen2.5:7b）----
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# 提示：
# - 不配置 LLM_BASE_URL 时，/agent/chat 使用受控的确定性聊天降级，/agent/prepare 也可离线运行；此时不具备模型自主编排能力。
# - 模型只负责「编排工具」，金额计算、业务校验与写入口令始终由确定性代码控制。

# ---- ERP Adapter（默认 SQLite 合成数据；http 用于客户 API 联调）----
ERP_BACKEND=sqlite
ERP_API_BASE_URL=
ERP_API_TOKEN=
ERP_API_TIMEOUT=5
ERP_API_MAX_RETRIES=2

# ---- 可选 RBAC（默认关闭以便离线演示；开启后所有业务接口必须带 Bearer Token）----
ERP_AUTH_ENABLED=false
# Token 必须使用随机值并只放 .env；以下只是结构示例，切勿照抄占位符。
ERP_AUTH_IDENTITIES_JSON={"替换成viewer随机token":{"user_id":"viewer_demo","role":"viewer"},"替换成operator随机token":{"user_id":"operator_demo","role":"operator"},"替换成approver随机token":{"user_id":"approver_demo","role":"approver"}}
ERP_UI_API_TOKEN=
ERP_MCP_API_TOKEN=

# ---- 可观测性（结构化 JSON 日志；/metrics 提供进程内演示指标）----
LOG_LEVEL=INFO

# ---- 飞书自建应用（长连接机器人，见 docs/飞书接入方案.md）----
# 在飞书开放平台 → 开发者后台 → 你的应用 → 「凭证与基础信息」里获取。
FEISHU_APP_ID=cli_替换成你的AppID
FEISHU_APP_SECRET=替换成你的AppSecret
# 白名单：只允许这些 open_id 使用（逗号分隔）。留空 = 不限制。
# 两道门的关系：飞书后台「版本管理与发布 → 可用范围」是第一道门（决定谁能搜到并使用机器人），
# 这里只是应用内的第二道门。若可用范围已限定为「仅自己」，这里留空也安全；
# 只有当你放宽可用范围（例如给别人演示）时，才需要把 open_id 填到这里。
# 获取 open_id：先留空启动机器人，给它发一句话，日志会打印 `[info] 收到文本 open_id=ou_...`。
FEISHU_ALLOWED_OPEN_IDS=
# 群里被 @ 时才响应（单聊不受影响）。
FEISHU_REQUIRE_MENTION_IN_GROUP=true
# 回复使用消息卡片（渲染 Markdown、按语义上色：报错橙/成功绿）。设为 false 退回纯文本。
# 注意：卡片仅为展示增强，写入仍需用户回复「确认提交」口令，卡片上没有一键写入按钮。
FEISHU_REPLY_CARD=true
