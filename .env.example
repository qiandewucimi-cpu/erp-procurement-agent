# 复制为 .env 并按需填写（.env 已被 .gitignore 排除，不会提交）。

# ---- 方式一：本地 Ollama（默认，离线可用，无需 key）----
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2:1.5b

# ---- 方式二：云端千问 DashScope（OpenAI 兼容）----
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-替换成你的key

# ---- 方式三：云端智谱（OpenAI 兼容）----
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
# LLM_API_KEY=替换成你的key

# 提示：不配置 LLM_BASE_URL 时，Agent 自动走确定性回退，仍可稳定运行。
# LLM 只负责「意图识别」，金额计算、业务校验与写入权限始终由确定性代码控制。
