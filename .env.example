# 复制为 .env 并按需填写（.env 已被 .gitignore 排除，不会提交）。

# ---- 推荐：云端模型（支持工具调用，实现真正的 Agent 工具循环）----
# 智谱（OpenAI 兼容，glm-4-flash 支持 function calling）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_API_KEY=替换成你的key

# 备选：千问 DashScope（OpenAI 兼容）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-替换成你的key

# ---- 备选：本地 Ollama（离线可用；小模型工具调用不稳，建议 ≥ qwen2.5:7b）----
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# 提示：
# - 不配置 LLM_BASE_URL 时，/agent/chat 会返回模型不可用提示，/agent/prepare 仍可离线运行。
# - 模型只负责「编排工具」，金额计算、业务校验与写入口令始终由确定性代码控制。

# ---- 飞书自建应用（长连接机器人，见 docs/飞书接入方案.md）----
# 在飞书开放平台 → 开发者后台 → 你的应用 → 「凭证与基础信息」里获取。
FEISHU_APP_ID=cli_替换成你的AppID
FEISHU_APP_SECRET=替换成你的AppSecret
# 白名单：只允许这些 open_id 使用（逗号分隔）。留空 = 不限制。
# 两道门的关系：飞书后台「版本管理与发布 → 可用范围」是第一道门（决定谁能搜到并使用机器人），
# 这里只是应用内的第二道门。若可用范围已限定为「仅自己」，这里留空也安全；
# 只有当你放宽可用范围（例如给别人演示）时，才需要把 open_id 填到这里。
# 获取 open_id：先留空启动机器人，给它发一句话，日志会打印 `[info] 收到文本 open_id=ou_...`。
FEISHU_ALLOWED_OPEN_IDS=
# 群里被 @ 时才响应（单聊不受影响）。
FEISHU_REQUIRE_MENTION_IN_GROUP=true
